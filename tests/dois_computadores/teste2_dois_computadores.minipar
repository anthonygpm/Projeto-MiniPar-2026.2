# Programa de Teste 2 em dois computadores
# A subtarefa 1 (fatorial) roda num nucleo deste computador e a subtarefa 2
# (serie de Fibonacci) roda no computador 2. As duas executam ao mesmo tempo;
# o join espera cada uma e junta os resultados.
#
# Como executar:
#   1. No computador 2:  teste2_dois_computadores --worker 5001
#   2. Neste computador: teste2_dois_computadores   e digite o IP do computador 2
#   (Enter vazio = 127.0.0.1, para testar os dois papeis na mesma maquina)

func fatorial(n) {
    var fat = 1;
    var i = 1;
    while (i <= n) {
        fat = fat * i;
        i = i + 1;
    }
    return fat;
}

func fibonacci(limite) {
    var serie = [];
    var a = 0;
    var b = 1;
    var i = 0;
    while (i < limite) {
        serie.append(a);
        var prox = a + b;
        a = b;
        b = prox;
        i = i + 1;
    }
    return serie;
}

var ip = input("IP do computador 2 (Enter = 127.0.0.1): ");
if (ip == "") { ip = "127.0.0.1"; }

var t1 = fork fatorial(5) on core(1);           # computador 1
var t2 = fork fibonacci(8) on host(ip, 5001);   # computador 2

print("Fatorial de 5 (computador 1):", join t1);
print("Fibonacci (computador 2):", join t2);
