# Divisao real como no Python 3: 7 / 2 vale 3.5, e o quociente inteiro usa int()

func media(a, b) {
    return (a + b) / 2;
}

seq {
    print("==== Divisao e resto ====");
    print("7 / 2 =", 7 / 2);
    print("8 / 2 =", 8 / 2);
    print("-7 / 2 =", -7 / 2);
    print("1 / 3 =", format(1 / 3, 4));

    var n = 10;
    var m = 4;
    print("n / m =", n / m);
    print("int(n / m) =", int(n / m));
    print("floor(-7 / 2) =", floor(-7 / 2));
    print("n % m =", n % m);
    print("7.5 % 2 =", 7.5 % 2);

    print("media(3, 4) =", media(3, 4));

    # Quociente inteiro em laco: 0 .. 4, cada um duas vezes
    var quocientes = [];
    var i = 0;
    while (i < 10) {
        quocientes.append(int(i / 2));
        i = i + 1;
    }
    print("int(i / 2):", quocientes);
}
